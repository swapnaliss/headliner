# Names only. Values live in .env (gitignored) and the host environment.

# Qloo hackathon key (server-side only). The base URL is the only host this key works on.
QLOO_API_KEY=
QLOO_BASE_URL=

# LLM for intake and explanation (server-side only)
OPENAI_API_KEY=
LLM_MODEL=
LLM_DAILY_TOKEN_CEILING=
LLM_PER_IP_DAILY_TOKENS=

# Database (Neon connection string)
DATABASE_URL=

# Budgets
QLOO_PER_IP_DAILY_CALLS=
QLOO_GLOBAL_DAILY_CALLS=

# Set to fixtures to run with zero keys, no DB, no LLM
DEMO_MODE=

# Optional budget overrides (M2-05, docs/budget.md). Names only; defaults apply when unset.
# BUDGET_IP_QLOO_CALLS=
# BUDGET_IP_LLM_TOKENS=
# BUDGET_GLOBAL_QLOO_CALLS=
# BUDGET_GLOBAL_LLM_TOKENS=
# LLM_MODEL=
